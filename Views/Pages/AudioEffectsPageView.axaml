<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:vm="clr-namespace:CrossMediaPlayer.ViewModels.Pages"
              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
              x:Class="CrossMediaPlayer.Views.Pages.AudioEffectsPageView"
              x:DataType="vm:AudioEffectsPageViewModel"
              Background="White">
    <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="30,10,0,0">
        <Label FontSize="20" Margin="-20,0,0,40"
               Content="{Binding TranslationService[AudioEffects.AudioEffectsTitle]}">
        </Label>
        
    </StackPanel>
</UserControl>
